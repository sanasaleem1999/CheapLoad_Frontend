# Copy to .env.local (or .env) and fill in for your environment.
# Only REACT_APP_* variables reach the browser bundle. Values are PUBLIC.

# Backend REST API origin, no trailing slash
REACT_APP_API_URL=https://api.your-domain.com

# Socket.IO server origin, no trailing slash
REACT_APP_SOCKET_URL=https://api.your-domain.com
