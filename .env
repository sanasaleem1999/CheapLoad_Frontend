# ---------------------------------------------------------------------------
# Base environment (loaded for BOTH `npm start` and `npm run build`)
# Override per-environment in .env.development / .env.production,
# or locally (untracked) in .env.local / .env.development.local
#
# NOTE: Create React App only exposes variables prefixed with REACT_APP_.
# These values are INLINED into the JS bundle at build time and are therefore
# PUBLIC. Never put secrets (API keys, DB creds, tokens) in this file.
# After changing any value you must restart `npm start` / re-run `npm run build`.
# ---------------------------------------------------------------------------

# Backend REST API origin (no trailing slash)
REACT_APP_API_URL=https://y-ochre-seven-44.vercel.app

# Socket.IO server origin (usually the same host as the API)
REACT_APP_SOCKET_URL=https://y-ochre-seven-44.vercel.app
