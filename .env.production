# ---------------------------------------------------------------------------
# Loaded only by `npm run build` -- this is what ships to Hostinger.
# ---------------------------------------------------------------------------

REACT_APP_API_URL=https://y-ochre-seven-44.vercel.app
REACT_APP_SOCKET_URL=https://y-ochre-seven-44.vercel.app

# Don't fail the Hostinger build on ESLint warnings
CI=false

# Generating sourcemaps leaks your source; also keeps the upload small
GENERATE_SOURCEMAP=false

# Only set PUBLIC_URL if you deploy into a SUBFOLDER instead of the domain root,
# e.g. https://yourdomain.com/app/  ->  PUBLIC_URL=/app
# Leave commented out for a root-domain (public_html) deployment.
# PUBLIC_URL=/app
